# Equinox Nexus — Environment Variables
# Copy this file to .env.local and fill in your values

# ── Backend API ─────────────────────────────────────────────────────────────
# Get your free API key from https://console.groq.com
GROQ_API_KEY=

# ── Frontend ────────────────────────────────────────────────────────────────
# URL of the Equinox Nexus Python backend (FastAPI)
# Change this if you deploy the backend to a server
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Optional: External Data APIs ────────────────────────────────────────────
# Open-Meteo (free, no key needed — used for AQI)
# Numbeo (optional premium tier for real-time CoL data)
# NUMBEO_API_KEY=

# ── Optional: Database ──────────────────────────────────────────────────────
# Default: SQLite (core/twins.db) — no config needed
# For PostgreSQL production deployment:
# DATABASE_URL=postgresql://user:password@localhost:5432/equinox_nexus
