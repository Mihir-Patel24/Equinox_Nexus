# ── Database Configuration ─────────────────────────────────────────────────────
# Set dialect to "postgres" to activate PostgreSQL, or "sqlite" to run locally
DB_DIALECT=sqlite

# If postgres is chosen, specify connection details (or use DATABASE_URL)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/equinox_nexus

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=equinox_nexus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── LLM / AI Services ─────────────────────────────────────────────────────────
# REQUIRED for Decision Intelligence Agent (Groq llama-3.3-70b-versatile)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── External APIs (Optional — agents fall back gracefully if not set) ──────────
# Open-Meteo AQI: No key needed (free)
# ExchangeRate API: No key needed (free tier used by monitor + fiscal ghost)

# ── Research Agent (Phase 2) ──────────────────────────────────────────────────
# OECD & World Bank APIs are free and keyless — no config needed

# ── API Security (Phase 3) ────────────────────────────────────────────────────
# Set API_KEY_ENABLED=true to enforce API key authentication on all endpoints
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ENABLED=false
API_KEY=your_api_key_here

# Rate limiting: max requests per time window (per client IP)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
